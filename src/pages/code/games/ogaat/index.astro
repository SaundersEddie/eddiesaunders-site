---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import '../../../../styles/pages/code.css';

const focusAreas = [
  {
    title: 'Build the Game',
    type: 'Development',
    text: 'Small, focused game projects built from the first playable system through testing, polish, platform builds, and release.',
  },
  {
    title: 'Create the Assets',
    type: 'Graphics / Audio',
    text: 'Practical workflows for creating and preparing graphics, music, sound effects, and other assets needed to finish the game.',
  },
  {
    title: 'Share the Process',
    type: 'Videos / Writeups',
    text: 'Short lessons, longer development videos, project notes, repositories, and honest coverage of what worked and what absolutely did not.',
  },
];

const currentProject = {
  title: 'Bits & Bolts',
  type: 'First OGaaT project',
  status: 'In Process',
  text: `Bits & Bolts is a single-screen mobile puzzle game being built in Unity
    for Android and iOS. The project starts with a deliberately small gameplay
    idea, but follows the complete development process rather than stopping at
    a basic prototype.

    The series covers project structure, Unity's newer Input System, UI Toolkit,
    gameplay systems, graphics, music, sound effects, testing, mobile controls,
    advertising space, platform builds, and the work required to prepare the
    finished game for release.

    Each stage is documented through practical videos, project notes, code
    examples, and honest coverage of the decisions, mistakes, fixes, and
    occasional disasters involved in finishing a real game.`,
  youtubeUrl: 'https://www.youtube.com/@onegridatatime',
};

const sharedProjects = [
  {
    title: 'Godot TextController',
    type: 'Godot 4 / GDScript',
    status: 'Available',
    text: [
      'A reusable, self-contained text controller created while working on Godot projects and old-school game presentation effects.',
      'The controller supports left and right scrolling, horizontal and vertical bouncing, character-by-character sine-wave movement, static colors, two-color fades, and per-character color cycling.',
      'Movement, text effects, and color effects are independent, so they can be combined to create everything from simple animated titles to proper C64-style sine-wave scrollers.',
    ],
    links: [
      {
        label: 'View on GitHub',
        href: 'https://github.com/SaundersEddie/Godot-TextController',
      },
    ],
  },
  {
    title: 'Unity TextController',
    type: 'Unity 6 / C# / UI Toolkit',
    status: 'Available',
    text: [
      'A Unity 6 port of the Godot TextController, rebuilt with C# and UI Toolkit as a reusable component for arcade messages, title screens, attract modes, and retro game presentation.',
      'It supports scrolling in four directions, horizontal and vertical bouncing, character-by-character sine-wave movement, static colors, two-color fades, per-character color cycling, and whole-text fade controls.',
      'Movement, text effects, color effects, and opacity remain independent, while the controller creates and manages its character labels at runtime without requiring a hand-built UI hierarchy.',
    ],
    links: [
      {
        label: 'View on GitHub',
        href: 'https://github.com/SaundersEddie/Unity-TextController',
      },
    ],
  },
];
---

<BaseLayout
  title='One Grid at a Time | Eddie Saunders'
  description='One Grid at a Time follows the practical process of building focused games, development tools, graphics, audio, mobile builds, and finished releases.'
>
  <section class='page-hero code-hero ogaat-hero'>
    <p class='eyebrow'>Code / Games / OGaaT</p>
    <h1>One Grid at a Time</h1>
    <p>
      Building focused games one manageable system at a time — from the first
      line of code through graphics, audio, testing, platform builds,
      publishing, and all the broken bits in between.
    </p>

    <div class='project-links'>
      <a
        href='https://www.youtube.com/@onegridatatime'
        target='_blank'
        rel='noreferrer'
      >
        Watch on YouTube
      </a>
    </div>
  </section>

  <section class='project-showcase ogaat-section'>
    <div class='project-showcase-heading'>
      <p class='eyebrow'>The idea</p>
      <h2>Small enough to finish. Useful enough to share.</h2>

      <p>
        One Grid at a Time grew out of the development diary for Courier16.
        Diary of a Game started as a way to document one project: the ideas,
        design decisions, mistakes, fixes, progress, and lessons that came from
        building the game in public.
      </p>

      <p>
        As Courier16 developed, it became clear that the useful part was bigger
        than a single diary. The code, tools, graphics, audio, testing, platform
        builds, repositories, videos, and smaller lessons could all become part
        of a repeatable development process.
      </p>

      <p>
        One Grid at a Time is that process. Each project is kept focused enough
        to finish, but complete enough to cover the real work involved in taking
        a game from an early idea to a playable release.
      </p>

      <p>
        Courier16 keeps its original Diary of a Game journal. Future projects,
        beginning with Bits &amp; Bolts, will use the One Grid at a Time format
        from the start.
      </p>
    </div>
  </section>

  <section class='project-showcase'>
    <div class='project-showcase-heading'>
      <p class='eyebrow'>Current project</p>
      <h2>Starting with Bits &amp; Bolts</h2>
      <p>
        The first public OGaaT project is deliberately compact: one screen,
        clear mechanics, mobile-first controls, and enough real development
        problems to cover the complete journey from concept to release.
      </p>
    </div>

    <div class='project-grid'>
      <article class='project-card'>
        <p class='project-type'>{currentProject.type}</p>
        <h3>{currentProject.title}</h3>

        {
          currentProject.text
            .trim()
            .split('\n\n')
            .map((paragraph) => <p>{paragraph.trim()}</p>)
        }

        <div class='project-links'>
          <span>{currentProject.status}</span>

          <a href={currentProject.youtubeUrl} target='_blank' rel='noreferrer'>
            Follow Bits &amp; Bolts on YouTube
          </a>
        </div>
      </article>
    </div>

    <section class='project-showcase'>
      <div class='project-showcase-heading'>
        <p class='eyebrow'>Shared tools</p>
        <h2>Useful bits worth keeping</h2>
        <p>
          Not everything built during a game project needs to stay buried inside
          that game. Reusable systems and tools are cleaned up, documented, and
          shared when they can be useful elsewhere.
        </p>
      </div>

      <div class='project-grid'>
        {
          sharedProjects.map((item) => (
            <article class='project-card'>
              <p class='project-type'>{item.type}</p>
              <h3>{item.title}</h3>

              <div class='project-description'>
                {item.text.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>

              <div class='project-links'>
                {item.links.map((link) => (
                  <a href={link.href} target='_blank' rel='noreferrer'>
                    {link.label}
                  </a>
                ))}
              </div>

              <span>{item.status}</span>
            </article>
          ))
        }
      </div>
    </section>

    <section class='project-showcase'>
      <div class='project-showcase-heading'>
        <p class='eyebrow'>What OGaaT covers</p>
        <h2>More than just writing the code</h2>
        <p>
          Finishing a game means dealing with everything around the code too.
          OGaaT follows those parts instead of quietly pretending they happened
          off camera.
        </p>
      </div>

      <div class='project-grid'>
        {
          focusAreas.map((item) => (
            <article class='project-card'>
              <p class='project-type'>{item.type}</p>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
    </section>
  </section>
</BaseLayout>
